{
	"schemaVersion": 1,
	"id": "yudream-presence",
	"version": "${version}",
	"name": "YudreamPresence",
	"description": "把 Fabric 26.3 服务端的玩家进服 / 退服 / AFK / 在线名单上报到 YuDream Admin。",
	"authors": [
		"zhou-BZDDX"
	],
	"contact": {
		"homepage": "https://github.com/zhou-BZDDX/mcPlugin",
		"sources": "https://github.com/zhou-BZDDX/mcPlugin"
	},
	"license": "MIT",
	"environment": "server",
	"entrypoints": {
		"server": [
			"com.example.yudreampresence.YudreamPresence"
		]
	},
	"mixins": [
		{
			"config": "yudream-presence.mixins.json",
			"environment": "server"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~26.3",
		"java": ">=25"
	}
}
